# FollowerMatch+ server configuration. Copy to .env and run `npm run dev`,
# or set these in your host's environment. Every value is optional.

# Port and bind address.
PORT=3000
HOST=0.0.0.0

# Which SocialGraphProvider answers automatic lookups.
#   none  (default) – reports "automatic lookup unavailable"; the page sends
#                     people to the Instagram-export workflow
#   mock            – invented demo accounts (demo, demo.big, demo.private…)
#                     for development; refused when NODE_ENV=production
FMP_PROVIDER=none
# FMP_ALLOW_MOCK=1          # allow the mock under NODE_ENV=production (public demo only)
# FMP_MOCK_DELAY_MS=150     # simulated latency per mock request

# Credentials for a real provider go here and are read only inside that
# provider's module (server/providers/<name>.js). Never commit them.
# FMP_PROVIDER_API_KEY=

# Largest follower or following count automatic lookup will page through.
FMP_MAX_ACCOUNT_SIZE=25000
# Per-request upstream timeout, in milliseconds.
FMP_PROVIDER_TIMEOUT_MS=20000

# Rate limits, per client address.
FMP_RATE_PROFILE=20         # profile lookups per 15 minutes
FMP_RATE_PAGES=900          # list pages per 15 minutes
FMP_RATE_ACCOUNTS=5         # different accounts whose lists can be pulled per hour

# Set to 1 only behind a reverse proxy you control, so the client address is
# read from X-Forwarded-For instead of the socket.
FMP_TRUST_PROXY=0

# 1 silences the per-request log line (used by the tests).
FMP_QUIET=0
